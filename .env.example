# Discord: use DEBUG=true and a private TEST_CHANNEL for a safe first live scan.
# All channel and role values are positive Discord snowflake IDs.
DISCORD_TOKEN=
SWE_INTERNS=
SWE_NG=
QUANT_INTERNS=
QUANT_NG=
AI_INTERNS=
AI_NG=
POSTING_CHANNEL=
TEST_CHANNEL=
ROLE_ID_LOVES_NOTIFICATIONS=
ROLE_ID_JOB_PING=
# Summary and debug destinations.
DEBUG=true
MAX_SEND=50

# Local paths. Keep the SQLite database and backups out of version control.
DATABASE_PATH=data/jobs.sqlite3
COMPANY_REGISTRY=config/companies.json
DISCOVERY_SOURCES=config/discovery.json

# Scanning and adaptive scheduling.
ADAPTIVE_SCHEDULING=true
ACTIVE_SCAN_INTERVAL_SECONDS=1800
QUIET_TIERS_SECONDS=1800,7200,28800,86400,259200,604800,2592000
PRIORITY_SCAN_INTERVAL_SECONDS=7200
# Comma-separated provider:region:board keys; append =1800 for a 30-minute priority cadence.
# Example: ashby:global:example,lever:eu:another=1800
# Nvidia and Amazon are pinned automatically when registered by name or board identifier.
PRIORITY_BOARDS=
FAILURE_RETRY_SECONDS=1800
# Legacy scheduler alias; used only when ACTIVE_SCAN_INTERVAL_SECONDS is absent.
# SCAN_INTERVAL_SECONDS=1800
DISCOVERY_INTERVAL_SECONDS=86400

# HTTP behaviour: concurrent requests and minimum delay per host in seconds.
HTTP_CONCURRENCY=8
HTTP_HOST_INTERVAL_SECONDS=0.25
# Logging.
LOG_LEVEL=INFO
